DJANGO_SECRET_KEY=replace-with-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# For PostgreSQL on Amvera:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional persistent media path:
# DJANGO_MEDIA_ROOT=/app/media

# Optional automatic superuser creation on server:
# DJANGO_SUPERUSER_USERNAME=teacher
# DJANGO_SUPERUSER_EMAIL=teacher@example.com
# DJANGO_SUPERUSER_PASSWORD=strong-password