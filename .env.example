# LOCAL DEVELOPMENT ONLY. Never copy this profile unchanged to a public server.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Without DATABASE_URL, explicit DEBUG=True uses local SQLite.
# Generate DJANGO_SECRET_KEY with secrets.token_urlsafe(64); see README.md.
# Optional absolute private directory (default: <repo>/media in development):
# DJANGO_MEDIA_ROOT=/absolute/path/to/private-media
