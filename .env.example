# LOCAL DEVELOPMENT ONLY. Never copy this profile unchanged to a public server.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Without DATABASE_URL, explicit DEBUG=True uses local SQLite.
# Generate DJANGO_SECRET_KEY with secrets.token_urlsafe(64); see README.md.
# По умолчанию файлы заданий хранятся в <repo>/var/media (совпадает с
# /app/var/media в Docker и переживает git pull). Можно переопределить:
# DJANGO_MEDIA_ROOT=/absolute/path/to/private-media
# В production DJANGO_MEDIA_ROOT обязателен и должен указывать на
# постоянный volume (см. compose.yaml: private-media:/app/var/media).
# Никогда не делайте `docker compose down -v` для обычного redeploy — это удалит файлы.
