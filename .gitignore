```gitignore
# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Django specific
*.sqlite3
*.log
# Локальный MEDIA_ROOT по умолчанию (<repo>/media) — приватные файлы учеников.
media/
# Каталог рантайма из docker-compose/локального стенда (внутри — приватные файлы).
var/

# Dependencies
.venv/
venv/
env/
.env
.env.local
.env.*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
.coverage
htmlcov/
coverage/

# Скриншоты упавших браузерных проверок (артефакт CI)
test-results/

# Distribution / packaging
dist/
build/
*.egg-info/

# Собранная статика Django (collectstatic) — артефакт сборки, не коммитим.
staticfiles/
```node_modules/
