```gitignore
# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Django specific
*.sqlite3
*.log
# Локальный MEDIA_ROOT по умолчанию (<repo>/media) — приватные файлы учеников.
media/

# Dependencies
.venv/
venv/
env/
.env
.env.local
.env.*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
.coverage
htmlcov/
coverage/

# Distribution / packaging
dist/
build/
*.egg-info/

# Собранная статика Django (collectstatic) — артефакт сборки, не коммитим.
staticfiles/
```