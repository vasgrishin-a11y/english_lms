# Fill values in your platform's secret manager; do not commit the resulting file.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=lms.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://lms.example.com
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DJANGO_MEDIA_ROOT=/app/var/media
# Set True only behind a proxy which OVERWRITES X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=False
# Optional comma-separated trusted peer IPs/CIDRs for an overwritten X-Real-IP.
DJANGO_TRUSTED_PROXY_IPS=
# Secure cookies + HTTPS redirect default to True. HSTS defaults to 3600 seconds.
# HSTS includeSubDomains/preload deliberately require a domain-owner decision.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
# Run migrations as one release job. The default entrypoint only checks for pending migrations.
DJANGO_RUN_MIGRATIONS=false
DJANGO_CREATE_SUPERUSER=false
# Only needed for an explicit one-time `bootstrap_admin` job:
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
LMS_MAX_FILE_BYTES=20971520
LMS_STUDENT_QUOTA_BYTES=209715200
LMS_SUBMISSIONS_PER_HOUR=30
LMS_PAGE_SIZE=25
DJANGO_LOGIN_FAILURE_LIMIT=5
DJANGO_LOGIN_COOLOFF_MINUTES=15
# ── ИИ-помощник преподавателя: локальная модель, без облака ───────────────
# Помощник работает на Ollama или LM Studio: ключей нет, материалы не покидают
# сервер. Фото читает vision-модель, текст из DOCX/XLSX/PDF извлекается офлайн.
#   ollama    — http://localhost:11434/v1, модель по умолчанию qwen3-vl:8b
#   lmstudio  — http://localhost:1234/v1, модель задайте в LMS_AI_MODEL
#   свой шлюз — любое имя + LMS_AI_ENDPOINT и LMS_AI_API_KEY
# Подробности и требования к железу — docs/AI_PROVIDERS.md.
LMS_AI_ENABLED=1
LMS_AI_PROVIDER=ollama
# Локальная модель ключа не требует: включается явным флагом.
LMS_AI_LOCAL=1
LMS_AI_API_KEY=
# Модель: для Ollama — имя из `ollama list`, для LM Studio — id загруженной модели.
# Vision для фото: qwen3-vl:8b (лучший OCR), qwen2.5vl:7b, gemma3:4b, minicpm-v, llava.
LMS_AI_MODEL=qwen3-vl:8b
LMS_AI_ENDPOINT=
# response_format=json_object. Локальные модели его не любят: по умолчанию выключен.
LMS_AI_JSON_MODE=0
# Вложения: image (vision-модель) или none. Пусто — возможности провайдера.
LMS_AI_UPLOAD_KINDS=
# TLS нужен только своему шлюзу с внутренним УЦ.
LMS_AI_VERIFY_SSL=1
# LMS_AI_CA_BUNDLE=
LMS_AI_TIMEOUT=120
LMS_AI_MAX_FILE_BYTES=10485760
