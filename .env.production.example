# Fill values in your platform's secret manager; do not commit the resulting file.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=lms.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://lms.example.com
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DJANGO_MEDIA_ROOT=/app/var/media
# Set True only behind a proxy which OVERWRITES X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=False
# Optional comma-separated trusted peer IPs/CIDRs for an overwritten X-Real-IP.
DJANGO_TRUSTED_PROXY_IPS=
# Secure cookies + HTTPS redirect default to True. HSTS defaults to 3600 seconds.
# HSTS includeSubDomains/preload deliberately require a domain-owner decision.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
# Run migrations as one release job. The default entrypoint only checks for pending migrations.
DJANGO_RUN_MIGRATIONS=false
DJANGO_CREATE_SUPERUSER=false
# Only needed for an explicit one-time `bootstrap_admin` job:
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
LMS_MAX_FILE_BYTES=20971520
LMS_STUDENT_QUOTA_BYTES=209715200
LMS_SUBMISSIONS_PER_HOUR=30
LMS_PAGE_SIZE=25
DJANGO_LOGIN_FAILURE_LIMIT=5
DJANGO_LOGIN_COOLOFF_MINUTES=15
# ── ИИ-помощник преподавателя (гибрид: ИИ по ключу, иначе офлайн-разбор) ──
# LMS_AI_ENABLED=1 включает окно помощника. Пустой ключ = офлайн-разбор файлов.
LMS_AI_ENABLED=1
# Провайдер и его ключ. GigaChat доступен из РФ без VPN и бесплатен для физлиц
# (Freemium), ключ авторизации выдаётся на developers.sber.ru.
#   gigachat   — Сбер, без VPN, читает фото и PDF (по умолчанию)
#   yandex     — Yandex AI Studio, Api-Key + модель gpt://<folder_id>/yandexgpt-5.1
#   proxyapi | vsegpt | aitunnel | openrouter | deepseek | qwen | ollama — OpenAI-совместимые
#   gemini     — Google, из РФ недоступен без VPN
#   openai     — свой шлюз: задайте LMS_AI_ENDPOINT
# Подробное сравнение бесплатных вариантов — docs/AI_PROVIDERS.md.
LMS_AI_PROVIDER=gigachat
LMS_AI_API_KEY=
# Модель и адрес: пусто = значения провайдера по умолчанию.
LMS_AI_MODEL=
LMS_AI_ENDPOINT=
# GigaChat: доступ юрлица и корпоративный — только через scope и точку OAuth.
# LMS_AI_AUTH_ENDPOINT=
# LMS_AI_SCOPE=GIGACHAT_API_B2B
# GigaChat использует сертификат НУЦ Минцифры. Скачайте корневой сертификат и
# укажите путь к нему; LMS_AI_VERIFY_SSL=0 отключает проверку TLS (небезопасно).
# curl -k "https://gu-st.ru/content/Other/doc/russian_trusted_root_ca.cer" -o /app/var/russian_trusted_root_ca.pem
# LMS_AI_CA_BUNDLE=/app/var/russian_trusted_root_ca.pem
LMS_AI_VERIFY_SSL=1
# Вложения: image,pdf,video,audio или none. Пусто = возможности провайдера.
LMS_AI_UPLOAD_KINDS=
# response_format=json_object у OpenAI-совместимых шлюзов; Ollama и часть
# прокси его не поддерживают — тогда LMS_AI_JSON_MODE=0.
LMS_AI_JSON_MODE=1
LMS_AI_TIMEOUT=60
LMS_AI_MAX_FILE_BYTES=10485760
